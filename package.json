{
  "name": "sentry-crypto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "format": "prettier --write src server *.js *.json README.md docs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src server *.js *.json README.md docs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0",
    "serverless-http": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
